# ─── Aegis environment ───────────────────────────────────────────────
# The engine auto-detects the provider from whichever key is present
# (order: anthropic → groq → gemini → openrouter → openai → mock).
# Set LLM_PROVIDER to force one. With no key, the app runs in "mock" mode
# (heuristic analysis) so you can develop and demo the UI offline.

# Force a provider (optional):
#   "anthropic" | "openai" | "groq" | "gemini" | "openrouter" | "compatible" | "mock"
LLM_PROVIDER=

# Anthropic / Claude (paid, primary)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── FREE options (pick one — no card needed) ────────────────────────
# Groq — free + extremely fast, great for the live line-by-line demo.
#   Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — free tier, multilingual, multimodal (audio-ready).
#   Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — one key, many free models (rate-limited).
#   Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (paid) — or point OPENAI_BASE_URL at any compatible endpoint
# (Together, DeepInfra, local Ollama at http://localhost:11434/v1, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# ─── Day 3+ integrations (optional for now) ──────────────────────────
# Speech-to-text
ASSEMBLYAI_API_KEY=
# Trusted Circle alerts (email via Resend — leave blank to use demo/mock mode).
RESEND_API_KEY=
# Loved ones to email. Pick ONE style:
#   ALERT_CONTACTS  → names + emails (best — personalizes "Hi Sarah,")
#   ALERT_TO_EMAILS → plain comma-separated emails
#   ALERT_TO_EMAIL  → legacy single recipient (still works)
ALERT_CONTACTS=                    # e.g. Sarah:sarah@example.com, John:john@example.com
ALERT_TO_EMAILS=                   # e.g. sarah@example.com, john@example.com
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=Aegis <onboarding@resend.dev>
# ─── Voice — "Guardian Number" call-screening prototype (docs/12_TWILIO_SETUP.md) ───
# Twilio Programmable Voice. All optional → routes degrade to mock/simulation
# without these. NOTE: screening UNKNOWN inbound callers needs a PAID Twilio
# account; a trial works for a demo using VERIFIED test phones.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=                      # your Aegis Twilio number, e.g. +15551234567
# (legacy alias; TWILIO_NUMBER takes precedence)
TWILIO_FROM_NUMBER=

AEGIS_SENIOR_NUMBER=                # protected person's phone, rung into the conference
AEGIS_SENIOR_NAME=                 # protected person's name, used to personalize alerts
AEGIS_TRUSTED_NUMBERS=             # Trusted Circle, comma-separated: +1555...,+1555...
AEGIS_PUBLIC_URL=                  # public URL Twilio can reach (ngrok / Vercel), no trailing slash
AEGIS_DANGER_THRESHOLD=75          # risk score that triggers intervention
AEGIS_FALLBACK_MS=30000            # how long to wait for family before the safe fallback
AEGIS_VERIFY_TWILIO=               # set to 1 in production to reject non-Twilio webhook calls
                                   # (needs TWILIO_AUTH_TOKEN + AEGIS_PUBLIC_URL; off = allow all)
