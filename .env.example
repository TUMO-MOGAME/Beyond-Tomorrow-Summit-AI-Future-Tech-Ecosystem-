# ─── Aegis environment ───────────────────────────────────────────────
# The engine auto-detects the provider from whichever key is present.
# Set LLM_PROVIDER to force one. With no key, the app runs in "mock" mode
# (heuristic analysis) so you can develop and demo the UI offline.

# Force a provider: "anthropic" | "openai" | "mock" (optional)
LLM_PROVIDER=anthropic

# Anthropic / Claude (primary)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (fallback / alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Day 3+ integrations (optional for now) ──────────────────────────
# Speech-to-text
ASSEMBLYAI_API_KEY=
# Trusted Circle alerts (email via Resend — leave blank to use demo/mock mode)
RESEND_API_KEY=
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=Aegis <onboarding@resend.dev>
# (SMS via Twilio — future drop-in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
