{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run start)",
      "Bash(npm test)",
      "Bash(npm install)",
      "Bash(npx tsc --noEmit)",
      "Bash(node scripts/test_engine.mjs)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)"
    ]
  }
}
